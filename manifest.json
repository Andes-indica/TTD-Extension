{
  "manifest_version": 3,
  "name": "TTD Darshan Ticket Autofill",
  "version": "1.2.1",
  "description": "Automatically fills the TTD Tickets booking form after the virtual queue, so you never miss a slot.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://ttdevasthanams.ap.gov.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/TTD-Logo.png",
      "48": "icons/TTD-Logo.png",
      "128": "icons/TTD-Logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ttdevasthanams.ap.gov.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/TTD-Logo.png",
    "48": "icons/TTD-Logo.png",
    "128": "icons/TTD-Logo.png"
  }
}
